#!/bin/bash
# submit_template.pbs
#
# Template, not meant to be submitted as-is. The lines marked "EDIT ME" depend on the
# cluster's queue names, GPU resource syntax and module names (see check_node.sh).
#
# Builds and runs every algorithm in paper_algorithms/ one after another on one compute
# node, with each program's output going to its own log file.

#PBS -N paper_algorithms
#PBS -l select=1:ncpus=8:ngpus=4
#PBS -l walltime=00:30:00
#PBS -q gpu
#PBS -j oe
#PBS -o paper_algorithms.log

# ---- EDIT ME: module load lines ----
# CUDA usually has to be loaded before nvcc is on PATH.
# Replace with what `module avail` shows.
module load cuda

cd "$PBS_O_WORKDIR"/paper_algorithms || exit 1

NUMGPUS=4        # EDIT ME: match #PBS -l select=... ngpus= above
NUMFLOATS=65536
ITERS=100

run_one () {
    local dir="$1"
    local bin="$2"
    echo "===== $dir ====="
    ( cd "$dir" && make ARCH=native && ./"$bin" "$NUMGPUS" "$NUMFLOATS" "$ITERS" )
    echo
}

run_one Baseline_Barrier   baseline_barrier_allreduce
run_one LL                 ll_allreduce
run_one Sentinel            sentinel_allreduce
run_one Twoshot_LL          twoshot_ll_allreduce
run_one Twoshot_Sentinel    twoshot_sentinel_allreduce
run_one LL128_Atomic        ll128_atomic_allreduce

echo "All done -- see paper_algorithms.log (or the -o path above) for full output."
