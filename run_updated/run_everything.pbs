#!/bin/bash
#PBS -l select=1:ncpus=1:host=compute02+1:ncpus=1:host=compute03+1:ncpus=1:host=compute04
#PBS -l place=scatter
#PBS -q workq
#PBS -l walltime=03:00:00
#PBS -S /bin/bash

# Runs all three versions (v1 = paper_algorithms, v2 = paper_algorithms_v2, v3 = paper_algorithms_v3)
# with the same experiments on the same 3 machines, and writes one log per experiment into
# ~/IMT2023016/results_updated/<version>/logs/. Within each experiment the versions run one after
# the other (v1, v2, v3), so they see the same conditions.
#
# Submit from ~/IMT2023016/run_updated:  qsub run_everything.pbs   (after: bash setup.sh)
# Then build the tables:                 python3 make_results.py

R=/home/student4/IMT2023016/run_updated
OUT=/home/student4/IMT2023016/results_updated
ALL=Baseline_Barrier:LL:Sentinel:Twoshot_LL:Twoshot_Sentinel:LL128_Atomic:Bidirectional_DoubleBuffering
cd "$R"

header() {  # header <version label> <experiment text>
    echo "# results_updated log"
    echo "# version: $1"
    echo "# experiment: $2"
    echo "# job: ${PBS_JOBID:-?}   started: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "# nodes: $(sort -u "$PBS_NODEFILE" | tr '\n' ' ')"
    echo ""
}

run() {  # run <version> <log name> <experiment text> -- then settings come from the environment
    local v="$1" name="$2" text="$3"
    { header "$v" "$text"; CODE="$R/code/$v" TMPLOG="$R/tmp/$v" bash "$R/run_allreduce.sh"; } \
        > "$OUT/$v/logs/$name.txt" 2>&1
    echo "$(date '+%H:%M:%S') done: $v/logs/$name.txt"
}

echo "$(date '+%H:%M:%S') start, job ${PBS_JOBID:-?}"

# 0. Network floor (does not depend on the version)
{ header "none" "network floor, ib_write_lat and ib_write_bw, first two nodes"; TMPLOG="$R/tmp/floor" bash "$R/run_floor.sh"; } \
    > "$OUT/floor/logs/network_floor.txt" 2>&1
echo "$(date '+%H:%M:%S') done: floor/logs/network_floor.txt"

# 1. 3 ranks, small and medium sizes: 32 B, 64 B, 128 B, 32 KB
for v in v1 v2 v3; do
    PROGRAMS=$ALL SIZES=8:16:32:8192 ITERS=1000 TIMEOUT=60 \
        run $v 1_3ranks_32B_64B_128B_32KB "3 ranks, all algorithms, 32 B / 64 B / 128 B / 32 KB, 1000 rounds"
done

# 2. 3 ranks, 256 KB (the size of the first results sent to the professor)
for v in v1 v2 v3; do
    PROGRAMS=$ALL SIZES=65536 ITERS=100 TIMEOUT=120 \
        run $v 2_3ranks_256KB "3 ranks, all algorithms, 256 KB, 100 rounds"
done

# 3. 3 ranks, 32 MB
for v in v1 v2 v3; do
    PROGRAMS=$ALL SIZES=8388608 ITERS=100 TIMEOUT=300 \
        run $v 3_3ranks_32MB "3 ranks, all algorithms, 32 MB, 100 rounds"
done

# 4. 2 ranks, Baseline and LL (to see how the time grows from 2 to 3 ranks)
for v in v1 v2 v3; do
    { header "$v" "2 ranks, Baseline and LL, 32 B / 64 B / 128 B / 32 KB (1000 rounds) and 32 MB (100 rounds)"
      CODE="$R/code/$v" TMPLOG="$R/tmp/$v" RANKS=2 PROGRAMS=Baseline_Barrier:LL SIZES=8:16:32:8192 ITERS=1000 TIMEOUT=60 bash "$R/run_allreduce.sh"
      CODE="$R/code/$v" TMPLOG="$R/tmp/$v" RANKS=2 PROGRAMS=Baseline_Barrier:LL SIZES=8388608 ITERS=100 TIMEOUT=300 bash "$R/run_allreduce.sh"
    } > "$OUT/$v/logs/4_2ranks_baseline_ll.txt" 2>&1
    echo "$(date '+%H:%M:%S') done: $v/logs/4_2ranks_baseline_ll.txt"
done

# 5. RDMA atomics probe (v1 has no Atomic_Probe program)
for v in v2 v3; do
    PROGRAMS=Atomic_Probe SIZES=8 ITERS=10 TIMEOUT=60 \
        run $v 5_atomic_probe "Atomic_Probe: does the network card support RDMA atomics (needed by LL128)"
done

# 6. Negative test (v3 only): LL with the flag wait removed must FAIL the correctness check
PROGRAMS=LL_NoWait_NegativeTest SIZES=8:8192 ITERS=1000 TIMEOUT=60 \
    run v3 6_negative_test "negative test: LL with the wait removed, must print FAILED"

echo "$(date '+%H:%M:%S') all done. Now run: cd $R && python3 make_results.py"
