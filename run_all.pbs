#!/bin/bash
#PBS -N rdma_allreduce
#PBS -l nodes=3:ppn=1
#PBS -q workq
#PBS -l walltime=00:45:00
#PBS -S /bin/bash

# =============================================================================
# ONE script for every experiment. Choose what to run at submit time with
# environment variables (qsub -v). Lists are COLON-separated (a comma would be
# taken as the next variable by qsub -v).
#
#   PROGRAMS  which algorithms to run (default: all seven)
#               Baseline_Barrier : LL : Sentinel : Twoshot_LL : Twoshot_Sentinel :
#               LL128_Atomic : Bidirectional_DoubleBuffering : Atomic_Probe
#   SIZES     message sizes in FLOATS (default 32:256:1024:4096:16384
#             = 128 B, 1 KiB, 4 KiB, 16 KiB, 64 KiB)
#   ITERS     timed iterations per run            (default 1000)
#   TIMEOUT   per-run hard limit in seconds       (default 90; a hang shows as exit=124)
#   BASE      folder holding the program folders
#             (default /home/student4/IMT2023016/paper_algorithms_v2)
#
# Number of ranks = number of nodes you ask for (-l nodes=N:ppn=1, default 3).
# Bidirectional_DoubleBuffering and Atomic_Probe always use exactly 2 ranks.
#
# Examples (run from ~/IMT2023016):
#   qsub run_all.pbs                                   # everything, 5 sizes, 3 ranks
#   qsub -v PROGRAMS=Sentinel:Twoshot_Sentinel run_all.pbs
#   qsub -v PROGRAMS=LL:Twoshot_LL,SIZES=32:512 run_all.pbs   # comma between variables,
#                                                             # colon between list items
#   qsub -v SIZES=65536,ITERS=100 run_all.pbs          # the original 256 KiB run
#   qsub -v PROGRAMS=Atomic_Probe run_all.pbs          # hardware atomic-support diagnostic
#   qsub -l nodes=5:ppn=1 run_all.pbs                  # 5 ranks
# =============================================================================

set -u
BASE="${BASE:-/home/student4/IMT2023016/paper_algorithms_v2}"
PROGRAMS="${PROGRAMS:-Baseline_Barrier:LL:Sentinel:Twoshot_LL:Twoshot_Sentinel:LL128_Atomic:Bidirectional_DoubleBuffering}"
SIZES="${SIZES:-32:256:1024:4096:16384}"
ITERS="${ITERS:-1000}"
TIMEOUT="${TIMEOUT:-90}"
LOGDIR="$BASE/run_logs"
mkdir -p "$LOGDIR"
rm -f "$LOGDIR"/*.log

N=$(sort -u "$PBS_NODEFILE" | wc -l)
echo "Allocated node count: $N"
echo "PROGRAMS=$PROGRAMS"
echo "SIZES=$SIZES floats   ITERS=$ITERS   TIMEOUT=${TIMEOUT}s"

# --- Discover each node's hostname and InfiniBand (10.1.x.x) address ----------
# pbsdsh does not relay a remote command's stdout here, so each task writes to a
# file in the shared NFS folder and we read the files back.
for i in $(seq 0 $((N-1))); do
    pbsdsh -n "$i" -- bash -c "{ hostname; echo '---'; hostname -I 2>&1; } > '$LOGDIR/mesh_${i}.log'" &
done
wait

IPS=()
for i in $(seq 0 $((N-1))); do
    HOST=$(sed -n 1p "$LOGDIR/mesh_${i}.log")
    IP=$(grep -oE '10\.1\.2\.[0-9]+' "$LOGDIR/mesh_${i}.log" | head -1)
    IPS+=("$IP")
    echo "rank $i -> host $HOST -> ib0 $IP"
done

# --- Program table: folder name -> binary, rank count, extra args after numFloats
bin_for() {
    case "$1" in
        Baseline_Barrier)                bin=baseline_barrier_rdma;          ranks=$N; extra="" ;;
        LL)                              bin=ll_allreduce_rdma;              ranks=$N; extra="" ;;
        Sentinel)                        bin=sentinel_allreduce_rdma;        ranks=$N; extra="" ;;
        Twoshot_LL)                      bin=twoshot_ll_allreduce_rdma;      ranks=$N; extra="" ;;
        Twoshot_Sentinel)                bin=twoshot_sentinel_allreduce_rdma; ranks=$N; extra="" ;;
        LL128_Atomic)                    bin=ll128_atomic_allreduce_rdma;    ranks=$N; extra="" ;;
        Bidirectional_DoubleBuffering)   bin=bidir_doublebuffer_rdma;        ranks=2;  extra="8" ;;  # 8 chunks/iter
        Atomic_Probe)                    bin=atomic_probe;                   ranks=2;  extra="" ;;
        *) return 1 ;;
    esac
}

K=0
run_program() {
    local dir="$1" nfloats="$2"
    bin_for "$dir" || { echo "!! unknown program '$dir'"; return; }
    local port=$((20000 + K * 50)); K=$((K + 1))
    local iplist="${IPS[@]:0:$ranks}"
    echo ""
    echo "=== $dir ($ranks ranks, $nfloats floats) ==="
    for i in $(seq 0 $((ranks-1))); do
        local log="$LOGDIR/${dir}_rank${i}.log"
        local cmd="timeout $TIMEOUT '$BASE/$dir/$bin' '$i' '$ranks' '$port' $iplist '$nfloats' $extra '$ITERS' > '$log' 2>&1; echo exit=\$? >> '$log'"
        pbsdsh -n "$i" -- bash -c "$cmd" &
    done
    wait
    for i in $(seq 0 $((ranks-1))); do
        echo "--- $dir rank $i ---"
        grep -E "Correctness|Average|min=|rror|mismatch|M=|exit=|SKIPPED|PROBE" "$LOGDIR/${dir}_rank${i}.log" 2>/dev/null \
            || echo "(missing log file / no result lines)"
    done
}

IFS=':' read -ra PROG_LIST <<< "$PROGRAMS"
IFS=':' read -ra SIZE_LIST <<< "$SIZES"

for NF in "${SIZE_LIST[@]}"; do
    echo ""
    echo "################ message = $NF floats ($((NF * 4)) bytes), $ITERS iters ################"
    for p in "${PROG_LIST[@]}"; do
        # The probe does not depend on message size: run it once, with the first size.
        if [ "$p" = "Atomic_Probe" ] && [ "$NF" != "${SIZE_LIST[0]}" ]; then continue; fi
        run_program "$p" "$NF"
    done
done

echo ""
echo "Finished."
