#!/bin/bash
#PBS -l select=1:ncpus=1:host=compute02+1:ncpus=1:host=compute03+1:ncpus=1:host=compute04
#PBS -l place=scatter
#PBS -q workq
#PBS -l walltime=00:30:00
#PBS -S /bin/bash

# Re-run of the small sizes only (32 B and 32 KB) of compare_v3_v5_v6.pbs; same settings, it
# overwrites the small_* logs. v3, v5 and v6 on the same three nodes. Only the programs v6 touches are run (Twoshot_LL and
# Twoshot_Sentinel); LL is included as a control, its code is the same in all versions so any
# difference there is noise. Every experiment is run twice, with the versions in opposite
# order, so a slow or fast moment on the machines does not favour one of them.
#
# Submit once from the jobs folder, and wait until it has left `qstat` before `python3 compare.py`:
#   qsub compare_small_v6.pbs
# Logs go to ~/IMT2023016/results_v6/logs; `python3 compare.py` makes the table.

ROOT=/home/student4/IMT2023016
OUT=$ROOT/results_v6
RUN=$ROOT/paper_algorithms_v6/jobs/run_allreduce.sh
PROGS=LL:Twoshot_LL:Twoshot_Sentinel

run() {  # run <experiment> <order> <version> <sizes> <iters> <timeout>
    local exp=$1 order=$2 v=$3 sizes=$4 iters=$5 to=$6
    local code=$ROOT/paper_algorithms_$v
    {
        echo "# version: $v"
        echo "# experiment: $exp, order $order"
        echo "# job: ${PBS_JOBID:-?}   started: $(date '+%Y-%m-%d %H:%M:%S')"
        echo "# nodes: $(sort -u "$PBS_NODEFILE" | tr '\n' ' ')"
        echo ""
        CODE=$code TMPLOG=$OUT/tmp/$v PROGRAMS=$PROGS SIZES=$sizes ITERS=$iters TIMEOUT=$to bash "$RUN"
    } > "$OUT/logs/${exp}_order${order}_${v}.txt" 2>&1
    echo "$(date '+%H:%M:%S') done: ${exp}_order${order}_${v}"
}

# experiment name : sizes in floats : rounds : timeout
for spec in "small:8:8192:1000:120"; do
    IFS=: read -r exp rest <<< "$spec"
    iters=$(echo "$rest" | awk -F: '{print $(NF-1)}')
    to=$(echo "$rest" | awk -F: '{print $NF}')
    sizes=$(echo "$rest" | awk -F: '{s=$1; for(i=2;i<=NF-2;i++) s=s":"$i; print s}')
    for v in v3 v5 v6; do run "$exp" 1 $v "$sizes" "$iters" "$to"; done
    for v in v6 v5 v3; do run "$exp" 2 $v "$sizes" "$iters" "$to"; done
done
echo "all done"
