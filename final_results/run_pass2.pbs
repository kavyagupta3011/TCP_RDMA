#!/bin/bash
#PBS -l select=1:ncpus=1:host=compute02+1:ncpus=1:host=compute03+1:ncpus=1:host=compute04
#PBS -l place=scatter
#PBS -q workq
#PBS -l walltime=04:00:00
#PBS -S /bin/bash

# Pass 2 of the final runs: the same experiments as pass 1, versions in reverse order.
#
# Every experiment is run for all six versions and for the ring baseline, one after the other, on
# the same three machines. Pass 1 goes v1 -> v6 -> ring, pass 2 goes the other way round, so that
# a slow or fast moment on the cluster does not favour one version.
#
# Before submitting, once:   cd ~/IMT2023016/final_results && bash setup.sh
# Submit (one pass at a time, wait until it is finished):   qsub run_pass2.pbs
# Logs go to ~/IMT2023016/final_results/<folder>/logs/pass2_<experiment>.txt
# Then:   python3 make_final_results.py

ROOT=/home/student4/IMT2023016
FR=$ROOT/final_results
RUN=$FR/run_allreduce.sh
PASS=pass2
ORDER="ring v6 v5 v4 v3 v2 v1"
ALL=Baseline_Barrier:LL:Sentinel:Twoshot_LL:Twoshot_Sentinel:LL128_Atomic:Bidirectional_DoubleBuffering

folder_of() {
    case $1 in
        v1) echo paper_algorithms ;;   v2) echo paper_algorithms_v2 ;;  v3) echo paper_algorithms_v3 ;;
        v4) echo paper_algorithms_v4 ;; v5) echo paper_algorithms_v5 ;; v6) echo paper_algorithms_v6 ;;
        ring) echo baselines ;;
    esac
}
code_of() {   # where the built programs of a version are on the cluster
    case $1 in
        v1|v2|v3) echo $ROOT/run_updated/code/$1 ;;
        v4) echo $ROOT/paper_algorithms_v4 ;; v5) echo $ROOT/paper_algorithms_v5 ;; v6) echo $ROOT/paper_algorithms_v6 ;;
        ring) echo $ROOT/baselines ;;
    esac
}
header() {
    echo "# final_results log"
    echo "# version: $1"
    echo "# experiment: $2"
    echo "# job: ${PBS_JOBID:-?}   started: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "# nodes: $(sort -u "$PBS_NODEFILE" | tr '\n' ' ')"
    echo ""
}
run() {   # run <version> <log name> <text>; PROGRAMS, SIZES, ITERS, TIMEOUT (and RANKS) come from the environment
    local v="$1" name="$2" text="$3" f
    f=$(folder_of "$v")
    { header "$v" "$text"; CODE="$(code_of "$v")" TMPLOG="$FR/tmp/$v" bash "$RUN"; } \
        > "$FR/$f/logs/${PASS}_${name}.txt" 2>&1
    echo "$(date '+%H:%M:%S') done: $f/logs/${PASS}_${name}.txt"
}
progs_for() { if [ "$1" = ring ]; then echo Ring_AllReduce; else echo "$ALL"; fi; }
progs2_for() { if [ "$1" = ring ]; then echo Ring_AllReduce; else echo Baseline_Barrier:LL; fi; }

echo "$(date '+%H:%M:%S') start $PASS, job ${PBS_JOBID:-?}, order: $ORDER"

# 1. 3 ranks, 32 B / 64 B / 128 B / 32 KB, 1000 rounds
for v in $ORDER; do
    PROGRAMS=$(progs_for $v) SIZES=8:16:32:8192 ITERS=1000 TIMEOUT=60 \
        run $v 1_3ranks_32B_64B_128B_32KB "3 ranks, 32 B / 64 B / 128 B / 32 KB, 1000 rounds"
done

# 2. 3 ranks, 256 KB
for v in $ORDER; do
    PROGRAMS=$(progs_for $v) SIZES=65536 ITERS=100 TIMEOUT=120 \
        run $v 2_3ranks_256KB "3 ranks, 256 KB, 100 rounds"
done

# 3. 3 ranks, 1 MB
for v in $ORDER; do
    PROGRAMS=$(progs_for $v) SIZES=262144 ITERS=100 TIMEOUT=120 \
        run $v 3_3ranks_1MB "3 ranks, 1 MB, 100 rounds"
done

# 4. 3 ranks, 32 MB
for v in $ORDER; do
    PROGRAMS=$(progs_for $v) SIZES=8388608 ITERS=100 TIMEOUT=300 \
        run $v 4_3ranks_32MB "3 ranks, 32 MB, 100 rounds"
done

# 5. 2 ranks: Baseline and LL (the ring for the baselines folder), small sizes and 32 MB
for v in $ORDER; do
    f=$(folder_of $v)
    { header "$v" "2 ranks, Baseline and LL (ring for the baselines), 32 B / 32 KB (1000 rounds) and 32 MB (100 rounds)"
      CODE="$(code_of $v)" TMPLOG="$FR/tmp/$v" RANKS=2 PROGRAMS=$(progs2_for $v) SIZES=8:8192 ITERS=1000 TIMEOUT=60 bash "$RUN"
      CODE="$(code_of $v)" TMPLOG="$FR/tmp/$v" RANKS=2 PROGRAMS=$(progs2_for $v) SIZES=8388608 ITERS=100 TIMEOUT=300 bash "$RUN"
    } > "$FR/$f/logs/${PASS}_5_2ranks.txt" 2>&1
    echo "$(date '+%H:%M:%S') done: $f/logs/${PASS}_5_2ranks.txt"
done

# 6. RDMA atomics probe, 7. negative test (LL without the wait; must print FAILED)
# only for the versions whose folder has these programs
for v in $ORDER; do
    [ -d "$(code_of $v)/Atomic_Probe" ] || continue
    PROGRAMS=Atomic_Probe SIZES=8 ITERS=10 TIMEOUT=60 \
        run $v 6_atomic_probe "Atomic_Probe: does the network card support RDMA atomics (needed by LL128)"
done
for v in $ORDER; do
    [ -d "$(code_of $v)/LL_NoWait_NegativeTest" ] || continue
    PROGRAMS=LL_NoWait_NegativeTest SIZES=8:8192 ITERS=1000 TIMEOUT=60 \
        run $v 7_negative_test "negative test: LL with the wait removed, must print FAILED"
done

echo "$(date '+%H:%M:%S') $PASS finished."
